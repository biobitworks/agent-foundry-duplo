{
  "manifestVersion": "1.0",
  "id": "biobitworks.agentfoundry",
  "name": "Agent Foundry",
  "version": "0.1.1",
  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "biobitworks.agentfoundry/0.1.1/backend",
    "entryAssembly": "Duplo.Extension.AgentFoundry.dll"
  },
  "resources": [
    {
      "ticketOriginType": "AgentFoundryRun",
      "restSegment": "extensions/agentfoundry-runs",
      "subType": "agent-foundry-run",
      "archetype": "typed",
      "registrar": "DevOpsResource",
      "entityType": "Duplo.Extension.AgentFoundry.AgentFoundryRun",
      "specType": "Duplo.Extension.AgentFoundry.AgentFoundryRunSpec",
      "resultType": "Duplo.Extension.AgentFoundry.AgentFoundryRunResult",
      "hooksType": "Duplo.Extension.AgentFoundry.AgentFoundryRunHooks",
      "serviceType": "Duplo.Extension.AgentFoundry.AgentFoundryRunService"
    }
  ],
  "skills": [
    {
      "folder": "biobitworks.agentfoundry/0.1.1/skills/provision-agentfoundry",
      "isBuiltIn": true
    }
  ],
  "skillMappings": [
    {
      "originType": "AgentFoundryRun",
      "subType": "agent-foundry-run",
      "skillNames": [
        "provision-agentfoundry"
      ],
      "timeout": {
        "provision": 600,
        "deprovision": 120
      }
    }
  ],
  "frontend": {
    "remote": {
      "remoteName": "duploExtensionAgentfoundry",
      "remoteEntry": "/v1/aiservicedesk/extensions/biobitworks.agentfoundry/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "biobitworks.agentfoundry-devops",
        "title": "DevOps",
        "type": "collapsible-section",
        "children": [
          {
            "id": "biobitworks.agentfoundry-runs",
            "title": "Agent Foundry",
            "type": "item",
            "matIcon": "troubleshoot",
            "relativeUrl": "extensions/agentfoundry-runs",
            "order": 40
          }
        ]
      }
    ],
    "routes": [
      {
        "path": "extensions/agentfoundry-runs",
        "resourceType": "AgentFoundryRun",
        "subType": "agent-foundry-run"
      }
    ]
  }
}
